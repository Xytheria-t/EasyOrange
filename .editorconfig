# EditorConfig — 跨编辑器统一缩进/换行/编码
# https://editorconfig.org
# 与 google-java-format 对齐（4 空格、UTF-8、LF）

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# 数据/文档类：2 空格（递归覆盖全仓，如 backend/*.yaml、frontend/*.json）
[**/*.{yml,yaml,json,md}]
indent_size = 2

# shell 脚本：2 空格（递归覆盖，如 .githooks/、backend/keys/）
[**/*.{sh,bash}]
indent_size = 2

# Java：行宽 120（缩进 4 继承自 [*]，与 google-java-format 一致）
[**/*.java]
max_line_length = 120

# 前端 TS/TSX/JS/JSX/CSS/HTML 缩进 4 空格，与 biome.json formatter 的 indentWidth: 4 对齐
# （Biome 是前端格式化的唯一事实来源，EditorConfig 仅作编辑器基线）