# ===================================================================
# EasyOrange 本地开发环境变量（单一来源）
# ===================================================================
# 用法：复制本文件为根目录 .env（.env 已被 .gitignore 排除）。
# 但 .env 不是必需品 —— 所有变量在 application*.yaml / compose.yaml 中都有
# 开发默认值，不创建 .env 也能零配置启动，本文件仅用于覆盖默认值。
#
# 三类消费者各自原生读取，无需任何加载库：
#   • Docker Compose      —— 自动读取根 .env 做 ${VAR:-default} 插值（含集成测试经
#                            spring-boot-docker-compose 拉起 compose.yaml 时）
#   • 终端 JVM（mvnw / java -jar）—— Spring Boot 只认进程环境变量，需先导入：
#                                  set -a; source .env; set +a     # bash/zsh
#                                不导入则走 application*.yaml 的内置默认值
#   • IDEA 运行           —— 默认不读本文件；如需覆盖，用 Run Configuration 的
#                            Environment variables 或 EnvFile 插件
#
# 语法约定（写错会静默出错，务必区分）：
#   application*.yaml  → ${VAR:default}    单冒号，Spring 占位符语法
#   compose.yaml/shell → ${VAR:-default}   双字符 :-，Docker Compose / shell 语法
# ===================================================================

# -------------------------------------------------------------------
# MySQL —— EASYORANGE_DB_* 同时驱动容器初始化（MYSQL_USER/MYSQL_PASSWORD）
# 与应用连接，两边必须同源，改一处即可（compose.yaml 已按此接线）
# -------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root123456
EASYORANGE_DB_HOST=localhost
EASYORANGE_DB_PORT=3306
EASYORANGE_DB_NAME=easyorange
EASYORANGE_DB_USERNAME=easyorange_app
EASYORANGE_DB_PASSWORD=easyorange_app_dev

# -------------------------------------------------------------------
# Redis
# -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=easyorange123

# -------------------------------------------------------------------
# RabbitMQ
# -------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=easyorange
RABBITMQ_PASSWORD=easyorange123

# -------------------------------------------------------------------
# Elasticsearch（可选）
# easyorange.search.elasticsearch.enabled 默认 false，不启动 ES 也不影响应用启动；
# 需要时用 docker compose --profile search up -d 单独拉起
# -------------------------------------------------------------------
# ES_URIS=http://localhost:9200

# -------------------------------------------------------------------
# JWT RSA 密钥路径
# dev 留空 → 启动时自动生成 2048 位密钥对（重启后历史 Token 失效）
# 生产/演示必须设置 PEM 文件路径，生成：easyorange-backend/keys/generate-rsa-keypair.sh
# -------------------------------------------------------------------
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=

# -------------------------------------------------------------------
# 跨域白名单（dev 默认 http://localhost:5173）
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -------------------------------------------------------------------
# Spring Profile（compose 应用容器内固定 dev，此处供终端 JVM 使用）
# -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# -------------------------------------------------------------------
# 服务端 / 可观测（可选覆盖，注释值即内置默认）
# -------------------------------------------------------------------
# SERVER_PORT=8080                              # 仅 prod profile 读取
# SERVER_TRUSTED_PROXIES=127.0.0.1,localhost,0:0:0:0:0:0:0:1
# TRACING_SAMPLING_PROBABILITY=0.1              # 仅 prod profile 读取
# ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
# RATE_LIMIT_FILTER_ENABLED=true                # 压测时置 false 关闭限流

# -------------------------------------------------------------------
# AI 供应商密钥（可选，留空 → 对应 AI 功能降级，不影响应用启动）
# key 只放本文件，禁止写进源码或提交 git
# -------------------------------------------------------------------
# DEEPSEEK_API_KEY=
# QWEN_VL_API_KEY=
# EMBEDDING_API_KEY=
