# 生产环境配置

# API 基础 URL
VITE_API_BASE_URL=https://api.easyorange.com

# 应用标题
VITE_APP_TITLE=易橙坊 - 让闲置流转，让价值延续

# 应用版本
VITE_APP_VERSION=1.0.0

# 是否启用 Mock 数据
VITE_ENABLE_MOCK=false

# API 超时时间（毫秒）
VITE_API_TIMEOUT=10000

# 是否启用调试模式
VITE_DEBUG=false

# 图片上传最大大小（MB）
VITE_MAX_IMAGE_SIZE=5

# 图片压缩质量
VITE_IMAGE_QUALITY=0.75

# 默认分页大小
VITE_PAGE_SIZE=20

# 自动保存间隔（秒）
VITE_AUTO_SAVE_INTERVAL=30

# WebSocket 地址（默认自动从 location.host 推导，同源部署无需配置）
# VITE_WS_URL=wss://api.easyorange.com/ws
