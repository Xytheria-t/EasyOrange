{
    "name": "easyorange-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "node dev.mjs",
        "build": "tsc && vite build",
        "build:js": "vite build",
        "build:analyze": "cross-env NODE_ENV=production ANALYZE=true vite build --mode production",
        "preview": "vite preview",
        "lint": "biome check --write src/",
        "lint:check": "biome check src/",
        "format": "biome format --write src/",
        "format:check": "biome format --check src/",
        "typecheck": "tsc --noEmit",
        "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
        "typecheck:all": "npm run typecheck && npm run typecheck:test",
        "clean": "rimraf dist",
        "rebuild": "npm run clean && npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "npm run build && playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@radix-ui/react-avatar": "^1.2.0",
        "@radix-ui/react-checkbox": "^1.3.5",
        "@radix-ui/react-dialog": "^1.1.17",
        "@radix-ui/react-dropdown-menu": "^2.1.18",
        "@radix-ui/react-label": "^2.1.10",
        "@radix-ui/react-popover": "^1.1.17",
        "@radix-ui/react-radio-group": "^1.4.1",
        "@radix-ui/react-select": "^2.3.1",
        "@radix-ui/react-separator": "^1.1.10",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-switch": "^1.3.1",
        "@radix-ui/react-tabs": "^1.1.15",
        "@radix-ui/react-toast": "^1.2.17",
        "@radix-ui/react-tooltip": "^1.2.10",
        "@stomp/stompjs": "^7.3.0",
        "@tanstack/react-query": "^5.101.4",
        "@tanstack/react-virtual": "^3.13.24",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.8.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-helmet-async": "^3.0.0",
        "react-hook-form": "^7.80.0",
        "react-router-dom": "^7.14.2",
        "recharts": "^3.10.1",
        "tailwind-merge": "^3.5.0",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^4.4.3",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4.2.4",
        "@tanstack/react-query-devtools": "^5.101.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.1",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.6",
        "cross-env": "^10.1.0",
        "jsdom": "^29.1.1",
        "msw": "^2.14.6",
        "postcss": "^8.5.10",
        "rimraf": "^6.1.3",
        "rollup-plugin-visualizer": "^7.0.0",
        "tailwindcss": "^4.2.4",
        "terser": "^5.46.0",
        "typescript": "^5.3.0",
        "vite": "^8.0.13",
        "vitest": "^4.1.6"
    }
}
