#!/usr/bin/env bash
# EasyOrange pre-push hook — 重门禁（构建 + 测试，推送前执行）
#
# 职责（按被推送 commit 的变更路径分发，不做全量）：
#   1. 后端：easyorange-backend/ 下有非文档变更 → ./mvnw -Pci spotless:check（格式）+ ./mvnw test（含编译）
#   2. 前端：easyorange-frontend/ 下有非文档变更 → npm test（vitest run）
#
# 设计：
#   - 变更判定用「只放行纯文档」而非枚举触发文件名：枚举（*.java|pom.xml）会漏掉
#     src/test/resources/logback-test.xml、Flyway 迁移 SQL、.mvn/maven.config、
#     vitest.config.ts 等同样能改变测试结果的变更，门禁会随文件类型增加而静默失效
#   - 变更范围 = 远端基线 sha..本地 sha；新分支（远端 sha 全 0）无基线 → 全量跑
#   - pre-commit 保持轻量，构建/测试只在推送时付一次
#   - 失败统一 hook_fail 收口（含 SKIP 提示）
#
# 跳过方式：SKIP=git-hooks git push
# 安装方式：git config core.hooksPath .githooks
#
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC2034
HOOK_NAME="pre-push"
# shellcheck disable=SC2034
HOOK_CMD="push"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_lib.sh
source "$SCRIPT_DIR/_lib.sh"

if hook_should_skip; then
  hook_log "SKIP=${SKIP} set, skipping pre-push."
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
BACKEND_DIR="$ROOT/easyorange-backend"
FRONTEND_DIR="$ROOT/easyorange-frontend"

need_backend=0
need_frontend=0

# stdin：每行 <本地ref> <本地sha> <远端ref> <远端sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    hook_log "new branch push (no remote baseline) → full gate"
    need_backend=1
    need_frontend=1
    continue
  fi
  while IFS= read -r f; do
    case "$f" in
      # 纯文档不改变测试结果 → 放行；其余一切后端/前端文件都视为可能影响测试
      easyorange-backend/*.md)  ;;
      easyorange-backend/*)     need_backend=1 ;;
      easyorange-frontend/*.md) ;;
      easyorange-frontend/*)    need_frontend=1 ;;
    esac
  done < <(git diff --name-only --diff-filter=ACMR "$remote_sha" "$local_sha")
done

# 1. 后端：先格式（秒级，失败即止），再 mvn test
if (( need_backend )); then
  if [[ ! -x "$BACKEND_DIR/mvnw" ]]; then
    hook_warn "mvnw not found in $BACKEND_DIR, skipping backend gates"
  else
    # spotless 只在 -Pci profile 声明，与 CI（./mvnw verify -Pci）同源；
    # 排在 test 前：格式问题秒级失败，不必等完整测试跑完
    hook_log "Backend changes pushed → spotless:check (format gate)..."
    if (cd "$BACKEND_DIR" && ./mvnw -Pci spotless:check -q -B -ntp); then
      hook_ok "spotless:check"
    else
      hook_fail "spotless:check failed — 运行 'cd easyorange-backend && ./mvnw -Pci spotless:apply' 规范化格式"
    fi

    hook_log "Backend changes pushed → mvn test (compile + tests)..."
    # -fae 失败聚合到末尾；-nsu 不查 snapshot 远端；-B -ntp 静默
    if (cd "$BACKEND_DIR" && ./mvnw test -q -B -ntp -fae -nsu); then
      hook_ok "mvn test"
    else
      hook_fail "mvn test failed (see output above)"
    fi
  fi
else
  hook_log "No backend changes, skipping spotless:check + mvn test"
fi

# 2. 前端：npm test（vitest run，非 watch）
if (( need_frontend )); then
  if [[ ! -f "$FRONTEND_DIR/package.json" ]]; then
    hook_warn "frontend package.json not found, skipping npm test"
  else
    hook_log "Frontend changes pushed → npm test (vitest run)..."
    if (cd "$FRONTEND_DIR" && npm test); then
      hook_ok "npm test"
    else
      hook_fail "npm test failed (see output above)"
    fi
  fi
else
  hook_log "No frontend changes, skipping npm test"
fi

hook_ok "pre-push passed"
