#!/usr/bin/env bash
# EasyOrange pre-commit hook — 快速检查（全部基于 staged 内容）
#
# 职责（<100ms~数秒）：
#   1. 密钥扫描：gitleaks（硬门禁）或 grep 回退（仅 warn）
#   2. 尾随空白 / 文件末尾空行（git diff --cached --check）
#   3. merge 冲突标记残留
#   4. 大文件（默认 >2MB 阻断）
#   5. 前端：仅当 src/tests 下 ts/tsx 变更时跑 biome check
#   4. 版本漂移：仅当技术栈表 / pom / compose / ES 镜像变更时校验文档版本与权威来源一致
#   5. 测试口径漂移：文档/pom 变更时校验「集成测试是否存在」的声明与代码事实（*IT + failsafe 绑定）一致
#   6. 结构计数漂移：文档/pom/迁移/源码变更时校验「N 模块 / N Port / N ADR / N 消费者 / N 表 / N 条 ArchUnit 规则 / N 个 Prompt 模板」与代码事实一致
#
# 重门禁（构建 + 测试）在 pre-push，提交时不挡路。
#
# 跳过方式：SKIP=git-hooks git commit -m "..."
# 安装方式：git config core.hooksPath .githooks
#
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC2034
HOOK_NAME="pre-commit"
# shellcheck disable=SC2034
HOOK_CMD="commit"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_lib.sh
source "$SCRIPT_DIR/_lib.sh"

if hook_should_skip; then
  hook_log "SKIP=${SKIP} set, skipping pre-commit."
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
FRONTEND_DIR="$ROOT/easyorange-frontend"
files=$(staged_files)

# 1. 密钥扫描：gitleaks 硬门禁；未安装则 grep 仅警告（CI 仍兜底）
if ! scan_secrets_staged; then
  if gitleaks_available; then
    hook_fail "gitleaks found potential secrets in staged changes (see output above)"
  else
    hook_warn "secret-like pattern(s) detected above — please review. Install gitleaks (see README) for a hard local gate."
  fi
fi

# 2. 快速内容检查：全部基于 staged 内容，聚合一次打印
violations=0
report_violation() {
  local name="$1" out="$2"
  if [[ -n "$out" ]]; then
    violations=1
    printf '[%s] FAIL: %s\n%s\n' "$HOOK_NAME" "$name" "$out" >&2
  fi
}

ws=$(check_staged_whitespace)
cm=$(check_conflict_markers)
lf=$(check_large_files)
report_violation "whitespace / blank-line-at-EOF (git diff --cached --check)" "$ws"
report_violation "merge conflict markers left in staged files" "$cm"
report_violation "large file(s) staged (>2MB) — intentional?" "$lf"
if (( violations )); then
  hook_fail "fast content checks failed (fix above, or SKIP=git-hooks to bypass)"
fi

# 3. 前端：仅当 src/tests 下 ts/tsx/js/jsx 变更时跑 biome（工作区文件）
fe_files=$(echo "$files" \
  | grep -E '^easyorange-frontend/(src|tests)/.*\.(ts|tsx|js|jsx)$' \
  | sed 's|^easyorange-frontend/||' \
  || true)

if [[ -n "$fe_files" ]]; then
  local_biome="$FRONTEND_DIR/node_modules/.bin/biome"
  if [[ ! -x "$local_biome" ]]; then
    hook_warn "$local_biome not found, run 'npm install' first; skipping biome check"
  else
    hook_log "Frontend files staged → biome check ($(echo "$fe_files" | wc -l) files)..."
    # biome: --no-errors-on-unmatched 处理已删除但仍出现在 index 的文件
    # shellcheck disable=SC2086  # fe_files 需按词展开
    if (cd "$FRONTEND_DIR" && "$local_biome" check --no-errors-on-unmatched --diagnostic-level=error $fe_files); then
      hook_ok "biome check"
    else
      hook_fail "biome check failed (run 'npm run lint' to fix)"
    fi
  fi
else
  hook_log "No frontend TS changes, skipping biome check"
fi

# 4. 版本漂移：文档版本表（唯一权威落点）与 pom / compose / 镜像 tag 必须一致
drift_files=$(echo "$files" \
  | grep -E '^(doc/架构/架构-技术栈\.md|compose\.yaml|easyorange-backend/pom\.xml|infra/elasticsearch/Dockerfile)$' \
  || true)

if [[ -n "$drift_files" ]]; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "版本相关文件 staged → 校验文档版本与 pom/compose 一致性..."
    if python3 "$SCRIPT_DIR/check-version-drift.py"; then
      hook_ok "version drift check"
    else
      hook_fail "文档版本与 pom/compose 不一致（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping version drift check"
  fi
else
  hook_log "No version-source changes, skipping version drift check"
fi

# 5. 测试口径漂移：文档对「集成测试是否存在」的声明 vs 代码事实（*IT 文件 + pom 的 failsafe 绑定）
tier_files=$(echo "$files" \
  | grep -E '\.md$|^easyorange-backend/pom\.xml$' \
  || true)

if [[ -n "$tier_files" ]]; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "文档 / pom 变更 → 校验测试口径与代码事实一致..."
    if python3 "$SCRIPT_DIR/check-test-tier-drift.py"; then
      hook_ok "test tier drift check"
    else
      hook_fail "文档测试口径与代码不符（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping test tier drift check"
  fi
else
  hook_log "No doc/pom changes, skipping test tier drift check"
fi

# 6. 结构计数漂移：文档 / pom / 迁移脚本 / 源码变更时校验「N 模块 / N Port / N ADR /
#    N 消费者 / N 表 / N 条 ArchUnit 规则 / N 个 Prompt 模板」与代码事实一致（这几类数字无单一来源，靠人肉同步漂移过一整轮）
if [[ -n "$tier_files" ]] || echo "$files" | grep -qE '^easyorange-backend/.*(pom\.xml|\.sql|\.java)$'; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "文档 / pom / 迁移 / 源码变更 → 校验结构计数与代码事实一致..."
    if python3 "$SCRIPT_DIR/check-metrics-drift.py"; then
      hook_ok "metrics drift check"
    else
      hook_fail "文档声称的结构计数与代码不符（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping metrics drift check"
  fi
else
  hook_log "No doc/pom/migration/source changes, skipping metrics drift check"
fi

hook_ok "pre-commit passed"
