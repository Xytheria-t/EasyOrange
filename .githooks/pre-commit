#!/usr/bin/env bash
# EasyOrange pre-commit hook — 快速检查（全部基于 staged 内容）
#
# 职责（<100ms~数秒）：
#   1. 密钥扫描：gitleaks（硬门禁）或 grep 回退（仅 warn）
#   2. 尾随空白 / 文件末尾空行（git diff --cached --check）
#   3. merge 冲突标记残留
#   4. 大文件（默认 >2MB 阻断）
#   5. 前端：仅当 src/tests 下 ts/tsx 变更时跑 biome check
#   6. 后端：仅当 staged 有 .java 变更时跑 spotless:check（格式门禁，实测全后端 ~2s）
#   7. 测试口径漂移：文档/pom 变更时校验「集成测试是否存在」的声明与代码事实（*IT + failsafe 绑定）一致
#   8. 结构计数漂移：文档/pom/迁移/源码变更时校验「N 模块 / N Port / N ADR / N 消费者 / N 表 / N 条 ArchUnit 规则 / N 个 Prompt 模板」与代码事实一致
#   9. 上下文预算：AGENTS.md 变更时校验份数（≤3）与字符预算（根 3000 / 合计 18000）
#  10. 跨层级重复注释：源码变更时校验「方法/行内注释没有在复述本类的类注释」
#  11. 文档链接：*.md 变更时校验仓库内相对链接与锚点可解析
#
# 已摘除：版本漂移（check-version-drift.py）—— 文档不再复刻版本号，权威源只有 pom / compose；
# 回填 doc/技术栈.md 版本表时再挂回。
#
# 格式门禁（spotless）原先只挂 pre-push，攒到推送才爆 —— 一批提交集中返工，且提交与推送
# 之间的历史里已经留下不合规的中间态。palantir 格式化全后端实测 ~2s，仍在秒级快检量级内，
# 提前到提交时付掉；pre-push 留一份兜住 SKIP 绕过与合并带进来的格式问题。
#
# 重门禁（构建 + 测试）在 pre-push，提交时不挡路。
#
# 跳过方式：SKIP=git-hooks git commit -m "..."
# 安装方式：git config core.hooksPath .githooks
#
# shellcheck shell=bash
set -euo pipefail

# shellcheck disable=SC2034
HOOK_NAME="pre-commit"
# shellcheck disable=SC2034
HOOK_CMD="commit"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_lib.sh
source "$SCRIPT_DIR/_lib.sh"

if hook_should_skip; then
  hook_log "SKIP=${SKIP} set, skipping pre-commit."
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
FRONTEND_DIR="$ROOT/easyorange-frontend"
BACKEND_DIR="$ROOT/easyorange-backend"
files=$(staged_files)

# 1. 密钥扫描：gitleaks 硬门禁；未安装则 grep 仅警告（CI 仍兜底）
if ! scan_secrets_staged; then
  if gitleaks_available; then
    hook_fail "gitleaks found potential secrets in staged changes (see output above)"
  else
    hook_warn "secret-like pattern(s) detected above — please review. Install gitleaks (see README) for a hard local gate."
  fi
fi

# 2. 快速内容检查：全部基于 staged 内容，聚合一次打印
violations=0
report_violation() {
  local name="$1" out="$2"
  if [[ -n "$out" ]]; then
    violations=1
    printf '[%s] FAIL: %s\n%s\n' "$HOOK_NAME" "$name" "$out" >&2
  fi
}

ws=$(check_staged_whitespace)
cm=$(check_conflict_markers)
lf=$(check_large_files)
report_violation "whitespace / blank-line-at-EOF (git diff --cached --check)" "$ws"
report_violation "merge conflict markers left in staged files" "$cm"
report_violation "large file(s) staged (>2MB) — intentional?" "$lf"
if (( violations )); then
  hook_fail "fast content checks failed (fix above, or SKIP=git-hooks to bypass)"
fi

# 3. 前端：仅当 src/tests 下 ts/tsx/js/jsx 变更时跑 biome（工作区文件）
fe_files=$(echo "$files" \
  | grep -E '^easyorange-frontend/(src|tests)/.*\.(ts|tsx|js|jsx)$' \
  | sed 's|^easyorange-frontend/||' \
  || true)

if [[ -n "$fe_files" ]]; then
  local_biome="$FRONTEND_DIR/node_modules/.bin/biome"
  if [[ ! -x "$local_biome" ]]; then
    hook_warn "$local_biome not found, run 'npm install' first; skipping biome check"
  else
    hook_log "Frontend files staged → biome check ($(echo "$fe_files" | wc -l) files)..."
    # biome: --no-errors-on-unmatched 处理已删除但仍出现在 index 的文件
    # shellcheck disable=SC2086  # fe_files 需按词展开
    if (cd "$FRONTEND_DIR" && "$local_biome" check --no-errors-on-unmatched --diagnostic-level=error $fe_files); then
      hook_ok "biome check"
    else
      hook_fail "biome check failed (run 'npm run lint' to fix)"
    fi
  fi
else
  hook_log "No frontend TS changes, skipping biome check"
fi

# 3.5 管理端样式漂移：tsx / ts 里出现裸 hex、裸 rgba()、Tailwind 任意色值，
#      或引用未定义的 --admin-* 令牌 → 视觉取值只能来自 styles/admin.css。
#      规则写进 AGENTS.md 没人记得，机器拦才有约束力（清过一次散落：181 处裸 hex + 92 处任意色值）
if echo "$files" | grep -qE '^easyorange-frontend/src/admin/.*\.(ts|tsx)$'; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "管理端文件变更 → 校验样式取值是否走 admin.css 令牌..."
    if python3 "$SCRIPT_DIR/check-admin-style-drift.py" --staged; then
      hook_ok "admin style drift check"
    else
      hook_fail "管理端出现裸色值 / 任意色值 / 未定义令牌（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping admin style drift check"
  fi
else
  hook_log "No admin TS changes, skipping admin style drift check"
fi

# 3.6 C 端样式漂移：页面 CSS 出现白名单外的裸色值，或引用未定义且无 fallback 的
#      CSS 变量（悬空 var() 静默失效，不报错）——视觉取值走 styles/tokens.css 令牌。
#      2026-09 全站收口约 600 处裸色值 + 10 处悬空引用后上锁；admin 侧归 check-admin-style-drift.py
if echo "$files" | grep -qE '^easyorange-frontend/src/.*\.css$'; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "前端 CSS 变更 → 校验样式取值是否走 tokens.css 令牌..."
    if python3 "$SCRIPT_DIR/check-frontend-style-drift.py" --staged; then
      hook_ok "frontend style drift check"
    else
      hook_fail "C 端出现白名单外裸色值 / 悬空变量引用（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping frontend style drift check"
  fi
else
  hook_log "No frontend CSS changes, skipping frontend style drift check"
fi

# 4. 后端格式：staged 有 .java 变更时跑 spotless:check。唯一需要起 JVM 的检查，
#    但格式化全后端秒级完成；spotless 只在 -Pci profile 声明，与 CI 同源，不会本地过 CI 红。
#    例外口径：其余快检都只看 staged 内容，spotless 扫的是工作区源码 ——
#    工作区里未暂存的格式问题同样会被报出来，报错文案已写明，不算误判。
if echo "$files" | grep -qE '^easyorange-backend/.*\.java$'; then
  if [[ ! -x "$BACKEND_DIR/mvnw" ]]; then
    hook_warn "mvnw not found in $BACKEND_DIR, skipping backend format gate"
  else
    hook_log "后端 Java 变更 → spotless:check（格式门禁）..."
    if (cd "$BACKEND_DIR" && ./mvnw -Pci spotless:check -q -B -ntp); then
      hook_ok "spotless:check"
    else
      hook_fail "spotless:check failed — 运行 'cd easyorange-backend && ./mvnw -Pci spotless:apply' 规范化格式后重新暂存"
    fi
  fi
else
  hook_log "No backend Java changes, skipping spotless:check"
fi

# 5. 测试口径漂移：文档对「集成测试是否存在」的声明 vs 代码事实（*IT 文件 + pom 的 failsafe 绑定）
tier_files=$(echo "$files" \
  | grep -E '\.md$|^easyorange-backend/pom\.xml$' \
  || true)

if [[ -n "$tier_files" ]]; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "文档 / pom 变更 → 校验测试口径与代码事实一致..."
    if python3 "$SCRIPT_DIR/check-test-tier-drift.py"; then
      hook_ok "test tier drift check"
    else
      hook_fail "文档测试口径与代码不符（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping test tier drift check"
  fi
else
  hook_log "No doc/pom changes, skipping test tier drift check"
fi

# 6. 结构计数漂移：文档 / pom / 迁移脚本 / 源码变更时校验「N 模块 / N Port / N ADR /
#    N 消费者 / N 表 / N 条 ArchUnit 规则 / N 个 Prompt 模板」与代码事实一致（这几类数字无单一来源，靠人肉同步漂移过一整轮）
if [[ -n "$tier_files" ]] || echo "$files" | grep -qE '^easyorange-backend/.*(pom\.xml|\.sql|\.java)$'; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "文档 / pom / 迁移 / 源码变更 → 校验结构计数与代码事实一致..."
    if python3 "$SCRIPT_DIR/check-metrics-drift.py"; then
      hook_ok "metrics drift check"
    else
      hook_fail "文档声称的结构计数与代码不符（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping metrics drift check"
  fi
else
  hook_log "No doc/pom/migration/source changes, skipping metrics drift check"
fi

# 7. 上下文预算：AGENTS.md 变更时校验「份数 + 字符预算」——根文件每会话常驻，
#    模块级副本不会被自动加载（ZCode 只解析工作目录向上的一个），两份都不该再长回来
if echo "$files" | grep -qE '(^|/)AGENTS\.md$'; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "AGENTS.md 变更 → 校验 AI 上下文预算..."
    if python3 "$SCRIPT_DIR/check-context-budget.py"; then
      hook_ok "context budget check"
    else
      hook_fail "AI 上下文预算或结构违规（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping context budget check"
  fi
else
  hook_log "No AGENTS.md changes, skipping context budget check"
fi

# 8. 跨层级重复注释：源码变更时校验「方法/行内注释没有在复述本类的类注释」。
#    AGENTS.md「注释」一节写了这条，但写进文档没人记得——比「不复述代码」隐蔽，
#    单看行内注释通顺，只对照类注释才发现是第二遍。规则靠机器才有约束力。
if echo "$files" | grep -qE '^easyorange-backend/.*\.java$'; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "源码变更 → 校验方法注释未复述类注释..."
    if python3 "$SCRIPT_DIR/check-comment-dup.py"; then
      hook_ok "comment dup check"
    else
      hook_fail "方法/行内注释在复述类注释（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping comment dup check"
  fi
else
  hook_log "No backend Java changes, skipping comment dup check"
fi

# 9. 文档链接：*.md 变更时校验仓库内相对链接与锚点可解析——手册间互引很密（节号
#    `NN §x` 靠人肉同步，文件名与锚点这半边可以断言），改册名 / 拆册 / 重排章号时最容易静默失效
if echo "$files" | grep -qE '\.md$'; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "文档变更 → 校验相对链接与锚点..."
    if python3 "$SCRIPT_DIR/check-doc-links.py"; then
      hook_ok "doc links check"
    else
      hook_fail "存在失效的文档链接 / 锚点（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping doc links check"
  fi
else
  hook_log "No markdown changes, skipping doc links check"
fi

# 10. 走读类名巡检：02 散文里 `FooBar` 形式的类名必须还能在源码里搜到。
#     路径巡检只认「**文件**」行，重命名或重写整类而不改路径时它是绿的；这条补上
#     「散文提到了但类已经没了」这半——被追问时当场答不出来的正是这种漂移
if echo "$files" | grep -qE '\.md$|\.java$'; then
  if command -v python3 >/dev/null 2>&1; then
    hook_log "变更 → 走读类名巡检（散文中提到的类还在不在）..."
    if python3 "$ROOT/doc/interview/check-drift.py" --symbols; then
      hook_ok "walkthrough symbol check"
    else
      hook_fail "走读漂移：02 提到的类名在源码里已不存在（见上方输出；SKIP=git-hooks 可跳过）"
    fi
  else
    hook_warn "python3 not found, skipping walkthrough symbol check"
  fi
else
  hook_log "No doc / java changes, skipping walkthrough symbol check"
fi

hook_ok "pre-commit passed"
