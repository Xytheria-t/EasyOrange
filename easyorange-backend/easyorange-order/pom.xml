<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cartethyia</groupId>
        <artifactId>easyorange-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>easyorange-order</artifactId>

    <description>
        Order 订单模块 - 订单管理和交易处理
    </description>

    <dependencies>
        <!-- 依赖 Framework 模块 -->
        <dependency>
            <groupId>com.cartethyia</groupId>
            <artifactId>easyorange-framework</artifactId>
        </dependency>

        <dependency>
            <groupId>com.cartethyia</groupId>
            <artifactId>easyorange-common</artifactId>
        </dependency>

        <!-- 依赖 Product 模块（查询商品信息） - optional 因为适配器在 application 模块 -->
        <dependency>
            <groupId>com.cartethyia</groupId>
            <artifactId>easyorange-product</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 依赖 User 模块（查询用户信息） - optional 因为适配器在 application 模块 -->
        <dependency>
            <groupId>com.cartethyia</groupId>
            <artifactId>easyorange-user</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 依赖 Payment 模块（支付相关） - optional 因为适配器在 application 模块 -->
        <dependency>
            <groupId>com.cartethyia</groupId>
            <artifactId>easyorange-payment</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- MapStruct: DO ↔ Domain 映射，编译期生成实现类 -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <artifactId>lombok-mapstruct-binding</artifactId>
            <groupId>org.projectlombok</groupId>
            <version>0.2.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
