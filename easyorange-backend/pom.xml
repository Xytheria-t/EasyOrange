    <profiles>
        <!--
            CI 门禁 profile — 本地默认关闭，仅 CI 用 `./mvnw -Pci` 启用：
              • Spotless 格式强制
              • JaCoCo 覆盖率门禁（check）：80% 行 / 60% 分支，低于阈值即失败
            本地 `./mvnw install` 会跳过（JaCoCo prepare-agent/report 仍在默认构建，
            本地 `./mvnw test` 照常收集覆盖率），构建速度显著提升。
            注：OWASP dependency-check 已移出本 profile —— 境外 runner 上 NVD 拉取动辄 30-40
            分钟，不适合放在主门禁里阻塞每次 push/PR。改由独立 `-Powasp` profile + 非阻断
            security job 承担（见 `-Powasp` 注释）。
        -->
        <profile>
            <id>ci</id>
            <build>
                <plugins>
                    <!-- 后端代码格式强制：palantir-java-format（4 空格 / 120 列，与 .editorconfig 一致），
                         进 verify 阶段 check，格式不达标即 CI 红。本地 `-Pci spotless:apply` 可一键规范化 -->
                    <plugin>
                        <groupId>com.diffplug.spotless</groupId>
                        <artifactId>spotless-maven-plugin</artifactId>
                        <version>3.9.0</version>
                        <configuration>
                            <java>
                                <palantirJavaFormat>
                                    <version>2.97.0</version>
                                    <style>PALANTIR</style>
                                </palantirJavaFormat>
                                <removeUnusedImports/>
                            </java>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotless-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.14</version>
                        <executions>
                            <execution>
                                <id>coverage-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            OWASP dependency-check — 全依赖 NVD 漏洞扫描。独立 profile，由 CI 的 security job
            （非阻断，continue-on-error）单独启用，不混入主门禁 `-Pci`：
            境外 GitHub runner 上 nvd.nist.gov 慢/脆，首次扫描实测 39 分钟 —— 若放主门禁，
            每次 push/PR 都要等 30-40 分钟且随时可能因 NVD 抖动让 CI 红。
            本地按需运行：`./mvnw -Powasp verify -DskipTests`（需联网拉 NVD 增量，较慢）。
        -->
        <profile>
            <id>owasp</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>13.0.0</version>
                        <configuration>
                            <failBuildOnCVSS>8</failBuildOnCVSS>
                            <!-- 网络/基础设施故障（NVD 拉取失败、限流）不 fail —— 境外 runner 上
                                 nvd.nist.gov 慢/脆，缓存未命中时首次下载可能 30-40 分钟甚至超时。
                                 failOnError=false 让扫描失败只告警不 fail，真正的高危 CVE 仍由
                                 failBuildOnCVSS=8 兜底标记。即"实漏洞才红，基础设施抖动不红" -->
                            <failOnError>false</failOnError>
                            <formats>
                                <format>HTML</format>
                            </formats>
                            <skipTestScope>true</skipTestScope>
                            <skipProvidedScope>true</skipProvidedScope>
                            <!-- 显式数据目录：CI 里用 actions/cache 缓存它，NVD 库跨 run 复用，
                                 避免每次全新下载整库（nvd.nist.gov 慢/限流会让首次 run 挂 30+ 分钟） -->
                            <dataDirectory>${user.home}/.dependency-check-data</dataDirectory>
                            <!-- 关闭 OSS Index 第三方补充源：本环境网络不可达（每次查询都失败产生告警），
                                 权威 NVD 源足以支撑扫描；保留其余 analyzer（NVD/GitHub Advisory） -->
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                            <!-- 关闭 RetireJS：其 jsrepository.json 托管于 GitHub raw，本环境网络不可达，
                                 每次扫描都 Read timed out 中止整体分析。本项目为纯 Java 后端，唯一 JS 依赖
                                 （swagger-ui 捆绑 DOMPurify）已在 dependency-suppression.xml 定向豁免 -->
                            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                            <!-- 关闭 .NET Assembly Analyzer：本环境未安装 dotnet，每次扫描 Jar 都尝试
                                 分析 .NET 程序集并报 "dotnet executable not found" 错误，纯噪声无价值 -->
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <!-- 定向豁免无修复版/误报的 CVE（kotlin-stdlib、mysql-connector-j），见 dependency-suppression.xml -->
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/dependency-suppression.xml</suppressionFile>
                            </suppressionFiles>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            PIT 变异测试 — 评估测试套件对缺陷的真实检测能力（行/分支覆盖率的"金标准"补充）。
            默认不启用：PIT 较慢，按需运行 `./mvnw -Ppit test-compile pitest:mutationCoverage`。
            仅对 domain 层注入变异（聚合根状态机 / 领域服务 / 值对象校验），聚焦业务逻辑测试质量，
            避开 adapter / config / DTO 等样板代码的噪声变异。
            HTML 报告：target/pit-reports/index.html

            阈值门禁（对齐 JaCoCo haltOnFailure 约定）：本地默认 0 = 仅出报告不阻断；
            CI 启用门禁示例（基于 order 模块基线 70% mutation / 89% strength / 81% line）：
              ./mvnw -Ppit test-compile pitest:mutationCoverage \
                -Dpit.mutationThreshold=60 -Dpit.testStrengthThreshold=75 -Dpit.coverageThreshold=70
        -->
        <profile>
            <id>pit</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- 仅对 domain 层变异：聚合根状态机、领域服务、值对象校验 -->
                            <targetClasses>
                                <param>com.cartethyia.easyorange.*.domain.*</param>
                            </targetClasses>
                            <!-- 运行所有可能覆盖被变异代码的测试（PIT 按行覆盖自动筛选） -->
                            <targetTests>
                                <param>com.cartethyia.easyorange.*</param>
                            </targetTests>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <!-- 覆盖式报告，便于 CI 解析与本地查阅 -->
                            <timestampedReports>false</timestampedReports>
                            <!-- 模块无 domain 类时不报错（如纯 boot 模块） -->
                            <failWhenNoMutations>false</failWhenNoMutations>
                            <!-- 阈值门禁：默认 0 = 不阻断；CI 用 -D 覆盖启用 -->
                            <mutationThreshold>${pit.mutationThreshold}</mutationThreshold>
                            <testStrengthThreshold>${pit.testStrengthThreshold}</testStrengthThreshold>
                            <coverageThreshold>${pit.coverageThreshold}</coverageThreshold>
                            <!-- 注意：不配置 historyInputFile/historyOutputFile —— 增量历史是 PIT 的付费
                                 功能（pitest-history 商业插件，arcmutate），免费版开启会直接报
                                 "History has been enabled but no history plugin has been installed" 构建失败 -->
                            <jvmArgs>
                                <jvmArg>-XX:+EnableDynamicAgentLoading</jvmArg>
                                <jvmArg>--sun-misc-unsafe-memory-access=allow</jvmArg>
                                <jvmArg>--add-opens java.base/java.lang=ALL-UNNAMED</jvmArg>
                                <jvmArg>--add-opens java.base/java.lang.reflect=ALL-UNNAMED</jvmArg>
                                <jvmArg>--add-opens java.base/java.util=ALL-UNNAMED</jvmArg>
                            </jvmArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
