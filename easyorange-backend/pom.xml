        <mybatis-plus.version>3.5.17</mybatis-plus.version>

        <jackson3.version>3.2.1</jackson3.version>
        <jackson-annotations.version>2.22</jackson-annotations.version>
        <!-- Jackson 2.x 传递依赖固定到 2.22.1（含 CVE-2026-54515 修复，2.21.4 受影响） -->
        <jackson2.version>2.22.1</jackson2.version>
        <!-- 覆盖 Spring Boot 4.0.7 托管的版本：netty 追 CVE 补丁。Boot 后续补丁若托管更高版本可移除 -->
        <netty.version>4.2.17.Final</netty.version>
        <tomcat.version>11.0.24</tomcat.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.mapstruct.binding.version>0.2.0</lombok.mapstruct.binding.version>
        <jetbrains.annotations.version>26.1.0</jetbrains.annotations.version>

        <!-- Flyway 数据库迁移（覆盖 Spring Boot 4.0.7 托管的 11.14.1，升至 13.2.0 当前稳定版；MySQL 8.4 支持完整） -->
        <flyway.version>13.2.0</flyway.version>
        <archunit.version>1.5.0</archunit.version>
        <redisson.version>4.7.0</redisson.version>
        <springdoc.version>3.1.0</springdoc.version>
        <swagger-annotations.version>2.2.53</swagger-annotations.version>
        <spring-ai.version>2.0.0</spring-ai.version>

        <!-- JaCoCo 覆盖率门禁：本地默认不阻断，CI 用 -Djacoco.haltOnFailure=true 启用 -->
        <jacoco.haltOnFailure>false</jacoco.haltOnFailure>

        <!-- PIT 变异测试（1.25.8 修复 Java 25 BigDecimal/BigInteger mutator） -->
        <pitest.version>1.25.9</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
        <!-- PIT 阈值门禁：本地默认 0（仅出报告不阻断），CI 用 -Dpit.mutationThreshold=60 等启用 -->
        <pit.mutationThreshold>0</pit.mutationThreshold>
        <pit.testStrengthThreshold>0</pit.testStrengthThreshold>
        <pit.coverageThreshold>0</pit.coverageThreshold>
    </properties>

