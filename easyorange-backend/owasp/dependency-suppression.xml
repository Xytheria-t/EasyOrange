<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        CVE-2026-53914 (kotlin-stdlib / kotlin-stdlib-common, CVSS 9.8)
        豁免理由：
          1. 攻击面是 Kotlin 编译器「构建缓存元数据」的反序列化（Kotlin compiler build cache），
             本项目为纯 Java 后端，不编译 Kotlin，kotlin-stdlib 仅为 Spring AI / OpenAI 客户端的
             传递运行时依赖，生产环境不暴露该攻击面。
          2. 修复版本 Kotlin 2.4.20 尚未发布稳定版（最新稳定 2.4.10）。
        解除条件：Kotlin 2.4.20 稳定版发布后，升级 pom 的 <kotlin.version> 至 ≥ 2.4.20，
        并删除本豁免条目。
    -->
    <suppress>
        <notes>Kotlin 编译器构建缓存反序列化漏洞，纯 Java 项目无实际攻击面；待 Kotlin 2.4.20 稳定版修复后升级解除</notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/.*@.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
    </suppress>

    <!--
        mysql-connector-j 9.7.0（Spring Boot 4.0.8 托管的最高版本，Central 最新亦为 9.7.0）CVE 群：
        - CVE-2026-60192 / 60193 / 60317：受影响组件为 Oracle MySQL Connectors 的 Connector/Net（.NET），
          非 Connector/J（Java JDBC 驱动），dependency-check 按 CPE oracle:mysql_connector 误匹配。
        - CVE-2026-60586 / 60623 / 60624 / 61082：真实 Connector/J 漏洞，受影响 9.7.0-9.7.1，
          修复版 9.7.2 尚未发布，9.7.0 已是最新托管版本。
        解除条件：Boot 托管升级到 ≥ 9.7.2 后删除本豁免。
    -->
    <suppress>
        <notes>CVE 组件为 Connector/Net(.NET) 非 Connector/J(Java JDBC) 属 CPE 误匹配，或真实漏洞但 9.7.0 已是最新托管版本且修复版 9.7.2 未发布</notes>
        <packageUrl regex="true">^pkg:maven/com\.mysql/mysql-connector-j@.*$</packageUrl>
        <cve>CVE-2026-60193</cve>
        <cve>CVE-2026-60192</cve>
        <cve>CVE-2026-60586</cve>
        <cve>CVE-2026-60623</cve>
        <cve>CVE-2026-60624</cve>
        <cve>CVE-2026-61082</cve>
        <cve>CVE-2026-60317</cve>
    </suppress>

    <!--
        CVE-2025-15104 (validator.nu / Nu Html Checker)：攻击面是 validator.nu 作为 HTTP 服务时的
        SSRF 限制绕过。本项目仅在 hibernate-validator / json-schema-validator 的传递依赖中携带
        validator.nu 库，不将其作为网络服务运行，无实际攻击面。
    -->
    <suppress>
        <notes>validator.nu 库作为服务运行时的 SSRF 限制绕过，本项目仅传递依赖该库不作为服务运行</notes>
        <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/hibernate-validator@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>
    <suppress>
        <notes>validator.nu 库作为服务运行时的 SSRF 限制绕过，本项目仅传递依赖该库不作为服务运行</notes>
        <packageUrl regex="true">^pkg:maven/com\.networknt/json-schema-validator@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>

    <!--
        CVE-2020-29582 (kotlin-stdlib-common 1.9.10)：影响的 suite 函数漏洞已在 Kotlin 1.4.20
        修复，本依赖版本 1.9.10 远高于修复版，dependency-check 按 CPE 范围误报。
    -->
    <suppress>
        <notes>受影响的 Kotlin suite 函数漏洞已于 1.4.20 修复，1.9.10 不受影响，CPE 范围误报</notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib-common@.*$</packageUrl>
        <cve>CVE-2020-29582</cve>
    </suppress>

    <!--
        log4j-api-2.25.5 CVE-2026-49844：Boot 4.0.8 托管版仍在受影响区间（2.13.1–2.25.5，修复于 2.26.0）。
        升级到 2.26.x 需同步 log4j-core，脱离 Boot BOM 存在版本错配风险，且该 CVE 为低危（CVSS 5.9）不阻断。
        解除条件：Boot 托管 log4j 升至 ≥ 2.26.0 后删除。
    -->
    <suppress>
        <notes>Boot 4.0.8 托管 log4j-api 2.25.5 仍处 CVE-2026-49844 影响区间，修复版 2.26.0；跳版需同步 core 脱离 BOM 有错配风险，CVSS 5.9 非阻断</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-api@.*$</packageUrl>
        <cve>CVE-2026-49844</cve>
    </suppress>

    <!--
