          "legendFormat": "{{uri}}"
        }
      ],
      "title": "AI 端点 QPS（/api/ai/*）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "lineWidth": 2 },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/ai/.*\",status=\"429\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{uri=~\"/api/ai/.*\"}[5m])), 0.0001)",
          "legendFormat": "429 限流率"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/api/ai/.*\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{uri=~\"/api/ai/.*\"}[5m])), 0.0001)",
          "legendFormat": "5xx 错误率"
        }
      ],
      "title": "AI 端点降级 / 错误率（429 限流 · 5xx）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "mysql", "uid": "mysql" },
