        }
      ],
      "title": "AI 调用量（eo_ai_call_log / 小时）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "mysql", "uid": "mysql" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "max": 5, "min": 1, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
