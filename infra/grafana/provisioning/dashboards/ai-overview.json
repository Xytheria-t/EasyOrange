      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "mysql" },
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(created_at, '1d') AS time, AVG(judge_score) AS avg_score FROM eo_ai_call_log WHERE judge_score IS NOT NULL AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
