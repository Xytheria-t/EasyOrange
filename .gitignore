# ============================================
# EasyOrange - Git Ignore 配置
# 基于 GitHub 官方 Java/Node 模板 + 项目定制
# ============================================

# ---------- 编译产物 ----------
target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*

# ---------- 依赖 ----------
node_modules/

# ---------- 构建输出 ----------
easyorange-frontend/dist/
easyorange-frontend/build/
easyorange-shared/dist/
easyorange-miniprogram/dist/
*.tsbuildinfo

# ---------- IDE ----------
.idea/
*.iml
*.iws
*.ipr
.vscode/
.history/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
*~
.swp
.swo

# ---------- 🔒 敏感信息（安全关键） ----------
# 环境变量
.env
.env.local
.env.*.local
!**/.env.example

# Spring Boot 密钥配置
application-secret.*
application-local.*

# 证书与密钥
*.p12
*.pfx
*.jks
*.keystore
*.key

# 前端环境配置（可能包含 API Key）
easyorange-frontend/.env.production
easyorange-frontend/.env.development

# ---------- 运行时 ----------
logs/
*.db
*.sqlite
coverage/

# ---------- AI 工具与生成文件（隐私） ----------
.claude/*
.cursor/
.opencode/
.trae/
.agents/
.superpowers/

# 但 .claude/rules/ 是项目编码规范，纳入版本控制
!.claude/rules/
!.claude/rules/**

# AI 生成的代码地图
**/codemap.md

# ---------- 个人使用文档（不随仓库分发） ----------
# 面试/简历等个人用途内容，仅本地保留，不进版本控制
doc/interview/

# 测试产物
test-results/
playwright-report/
blob-report/
