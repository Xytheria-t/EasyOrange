# ==================== 前端项目 (easyorange-frontend) ====================
# 允许前端项目所有文件（覆盖上方的通用规则）
!easyorange-frontend/**/*

# 依赖目录（不上传）
easyorange-frontend/node_modules/

# 构建输出（不上传）
easyorange-frontend/dist/
easyorange-frontend/build/
easyorange-frontend/.next/
easyorange-frontend/.nuxt/
easyorange-frontend/.output/

# 敏感环境配置（不上传）- 保留 .env.example
easyorange-frontend/.env.local
easyorange-frontend/.env.development.local
easyorange-frontend/.env.test.local
easyorange-frontend/.env.production.local
easyorange-frontend/.env*.local

# 日志文件（不上传）
easyorange-frontend/npm-debug.log*
easyorange-frontend/yarn-debug.log*
easyorange-frontend/yarn-error.log*
easyorange-frontend/pnpm-debug.log*

# 编辑器配置（可选，根据需要调整）
# easyorange-frontend/.vscode/
easyorange-frontend/.idea/

# 测试覆盖率（不上传）
easyorange-frontend/coverage/

# TypeScript 缓存（不上传）
easyorange-frontend/*.tsbuildinfo

# Vite/Rollup 分析文件（可选）
easyorange-frontend/stats.html
easyorange-frontend/.rpt2_cache/

# ESLint/Prettier 缓存
easyorange-frontend/.eslintcache

